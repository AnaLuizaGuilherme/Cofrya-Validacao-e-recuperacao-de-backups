# Copie este arquivo para .streamlit/secrets.toml (uso local) ou cole o
# conteúdo em Settings > Secrets no painel do Streamlit Community Cloud.
# NUNCA versione o arquivo secrets.toml de verdade (só este .example).

TCC_HMAC_KEY = "uma-chave-secreta-de-laboratorio"

# Só necessário se for usar o ambiente de restauração "neon" (sem Docker):
NEON_API_KEY = "sua-chave-de-api-do-neon"
NEON_PROJECT_ID = "id-do-seu-projeto-neon"
